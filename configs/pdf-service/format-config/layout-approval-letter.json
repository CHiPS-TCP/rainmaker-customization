                "text": "{{villageName}} ",
                "decoration": "underline",
                "decorationStyle": "dotted"
              },
              {
                "text": "की ओर अनुमोदित रेखांक की प्रति सहित सूचनार्थ अग्रेषित।"
              }
            ],
            "margin": [40, 0, 0, 0]
