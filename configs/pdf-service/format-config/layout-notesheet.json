{
  "key": "layout-notesheet",
  "config": {
    "defaultStyle": {
      "font": "Cambay",
      "fontSize": 11,
      "alignment": "justify"
    },

    "footer": "function(currentPage, pageCount) { return { stack: [ { canvas: [ { type: 'line', x1: 40, y1: 0, x2: 555, y2: 0, lineWidth: 0.5, lineColor: 'black' } ], margin: [0, 0, 0, 10] }, { columns: [ { width: '*', text: '' }, { width: 'auto', text: 'Page ' + currentPage + ' of ' + pageCount, alignment: 'right', fontSize: 9 } ], margin: [40, 0, 40, 10] } ] }; }",

    "content": [
      {
  "table": {
    "widths": ["*", "auto", "*"],
    "body": [
      [
        {"text": "","border": [true, true, false, false]},
        {
          "text": "Raipur Regional Office",
          "alignment": "center",
          "fontSize": 15, 
          "bold":true,
          "border": [false, true, false, false],
          "margin": [5, 6, 5, 2]
        },
        {"text": "","border": [false, true, true, false]}
      ],
      [
        {"text": "","border": [true, false, false, true]},
        {
          "text": "NOTESHEET",
          "alignment": "center",
          "fontSize": 15,
          "bold": true,
          "decoration": "underline",
          "border": [false, false, false, true],
          "margin": [5, 2, 5, 6]
        },
        {"text": "","border": [false, false, true, true]}
      ]
    ]
  },
  "margin": [0, 10, 0, 10]
},
      {
        "style": "noc-table",
        "table": {
          "widths": ["16%", "34%", "25%", "25%"],
          "body": [
            [
              {
                "text": "Proposal Details",
                "border": [true, true, false, false],
                "fontSize": 9,
                "bold":true,
                "fillColor": "#f2f2f2"
              },
              {
                "text": "",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "",
                "border": [false, true, true, false],
                "style": "receipt-table-value"
              }
            ],
            [
              {
                "text": "File No.",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{applicationNo}}",
                "fontSize":9,
                "margin": [0, 2, 0, 2],
                "bold":true,
                "border": [false, false, false, false]
              },
              {
                "text": "Submitted On: ",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{SubmittedOn}}",
                "border": [false, false, true, false],
                "style": "receipt-table",
                "font": "Cambay"
              }
            ],
            [
              {
                "text": "Owner Name: ",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{combinedOwnersName}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "LTP Name",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{stakeHolderName}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],

            [
              {
                "text": "License No:",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{architectId}}",
                "border": [false, false, false, true],
                "style": "receipt-table",
                "font": "Cambay"
              },
              {
                "text": "LTP Mobile",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{stakeHolderMobileNumber}}",
                "border": [false, false, true, true],
                "style": "receipt-table"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "table": {
          "style": "noc-table",
          "widths": ["25%", "25%", "25%", "25%"],
          "body": [
            [
              {
                "text": "Officers Name",
                "style": "receipt-table-value",
                "fillColor": "#f2f2f2",
                "bold": true
              },
              {
                "text": "Designation",
                "style": "receipt-table",
                "font": "Cambay",
                "fillColor": "#f2f2f2",
                "bold": true
              },
              {
                "text": "Officer Remarks",
                "style": "receipt-table-value",
                "fillColor": "#f2f2f2",
                "bold": true
              },
              {
                "text": "Date",
                "style": "receipt-table",
                "fillColor": "#f2f2f2",
                "bold": true
              }
            ],
            "{{#var_notesheetData}}[{ \"text\": \"{{name}}\", \"style\": \"receipt-table-value\", \"alignment\": \"left\",\"border\": [true, true, true,true], \"margin\": [5, 0, 0, 0] },{ \"text\": \"{{designation}}\", \"style\": \"receipt-table-value\",\"border\": [true, true, true,true], \"alignment\": \"left\", \"margin\": [5, 0, 0, 0] }, { \"text\": \"{{remarks}}\", \"style\": \"receipt-table-value\", \"alignment\": \"left\", \"border\": [true, true, true,true],\"margin\": [5, 0, 0, 0] }, { \"text\": \"{{noteDate}}\", \"style\": \"receipt-table-value\", \"border\": [true, true, true,true], \"alignment\": \"left\", \"margin\": [5, 0, 0, 0] }]{{/var_notesheetData}}"
          ]
        },
        "margin": [0, 0, 0, 10]
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [0, 0, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 5]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 9,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 9,
        "color": "#000000",
        "margin": [0, 10, 0, 8]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 9,
        "fontWeight": 500,
        "alignment": "left",
        "margin": [3, 5, 0, 5]
      },
      "next-noc-table": {
        "fontSize": 9,
        "color": "#000000",
        "margin": [0, 18, 0, 8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 9,
        "fontWeight": 500,
        "margin": [2, 2, 0, 2]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": true,
        "fontSize": 9,
        "fontWeight": 500,
        "margin": [0, 2, 0, 2]
      },
      "receipt-approver": {
        "fontSize": 9,
        "bold": true,
        "margin": [0, 12, 0, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 9,
        "margin": [0, 6, 0, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 9,
        "margin": [0, 6, 0, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 9,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
