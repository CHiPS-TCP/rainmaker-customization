{
  "key": "layout-rejection-letter",
  "config": {
    "defaultStyle": {
      "font": "Cambay",
      "fontSize": 11,
      "alignment": "justify"
    },
    "content": [
      {
        "columns": [
          {
            "width": "auto",
            "text": "1332 (24)",
            "alignment": "left",
            "bold": true
          },
          {
            "width": "*",
            "text": "छत्तीसगढ़ राजपत्र, दिनांक {{otpverifieddate}}",
            "alignment": "center",
            "margin": [0, 0, 0, 0],
            "bold": true
          }
        ]
      },
      {
        "canvas": [
          {
            "type": "line",
            "x1": 20,
            "y1": 5,
            "x2": 500,
            "y2": 5
          },
          {
            "type": "line",
            "x1": 20,
            "y1": 9,
            "x2": 500,
            "y2": 9
          }
        ],
        "margin": [-10, -3, 0, 5]
      },

      {
        "text": "प्ररूप-सत्रह",
        "alignment": "center",
        "bold": true,
        "margin": [0, 0, 0, -2]
      },
      {
        "text": "(नियम 19(ख) देखिये)",
        "alignment": "center",
        "margin": [0, 0, 0, 2]
      },
      {
        "text": "नगर तथा ग्राम निवेश विभाग, छत्तीसगढ़",
        "alignment": "center",
        "margin": [0, 0, 0, 2]
      },
      {
        "text": "आदेश",
        "alignment": "center",
        "margin": [0, 0, 0, 2]
      },

      {
        "columns": [
          {
            "width": "*",
            "text": [
              { "text": "क्रमांक ", "bold": true },
              {
                "text": "{{applicationNo}}",
                "decoration": "underline",
                "decorationStyle": "dotted"
              }
            ],
            "alignment": "left"
          },
          {
            "width": "*",
            "text": [
              { "text": "दिनांक ", "bold": true },
              {
                "text": "{{otpverifieddate}}",
                "decoration": "underline",
                "decorationStyle": "dotted"
              }
            ],
            "alignment": "right",
            "margin": [0, 0, 0, 0]
          }
        ]
      },
      {
        "stack": [
          { "text": "प्रति," },
          {
            "text": "श्री/श्रीमती/सुश्री/ {{ownername}}",
            "margin": [20, 0, 0, 0],
            "decoration": "underline",
            "decorationStyle": "dotted"
          }
        ],
        "margin": [0, 0, 0, 0]
      },
      {
        "stack": [
          {
            "text": [
              { "text": "विषय - ", "bold": true },
              {
                "text": "विकास के लिए अनुज्ञा हेतु आवेदन पत्र ।"
              }
            ]
          },
          {
            "text": [
              { "text": "सन्दर्भ - ", "bold": true },
              {
                "text": "आपका आवेदन पत्र क्रमांक "
              },
              {
                "text": " {{applicationNo}} ",
                "decoration": "underline",
                "decorationStyle": "dotted"
              },
              {
                "text": "दिनांक "
              },
              {
                "text": " {{otpverifieddate}}",
                "decoration": "underline",
                "decorationStyle": "dotted"
              }
            ]
          }
        ],
        "margin": [0, 20, 0, 0]
      },

      {
        "text": "आपको एतद्द्वारा, सूचित किया जाता है कि संदर्भ अंतर्गत आपके आवेदन पत्र, यथावर्णित विकास कार्य कार्यान्वित करने की अनुमति देने से छत्तीसगढ़ नगर तथा ग्राम निवेश अधिनियम, 1973 (क्र. 23 सन् 1973) की धारा 30 की उप-धारा (1) के खण्ड (ग) के अधीन नीचे दिये गये आधारों पर इन्कार किया जाता हैं-",
        "margin": [30, 20, 0, 8]
      },

      {
        "ol": [
          {
            "text": "{{rejectionComments}}"
          }
        ],
        "margin": [40, 0, 0, 0]
      },

      {
        "stack": [
          { "text": "संचालक", "bold": true , "margin":[0 ,0 ,35,0]},
          { "text": "नगर तथा ग्राम निवेश विभाग," , "margin":[0 ,0 ,0,0], "bold": true },
          {
            "text": "छत्तीसगढ़, रायपुर", "margin":[0 ,0 ,15,0], "bold": true
          }
        ],
        "width": "*",
        "alignment": "right",
        "margin": [0,0,30,0]
      }
    ]
  }
}
